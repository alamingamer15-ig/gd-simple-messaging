{
  "name": "Godot Android Template Builder",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",

  "features": {
    "ghcr.io/devcontainers/features/java:1": {
      "version": "17",
      "installGradle": true,
      "gradleVersion": "8.10.2"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "3.12"
    }
  },

  "postCreateCommand": "sudo apt-get update && sudo apt-get install -y git build-essential scons pkg-config",

  "remoteUser": "vscode"
}
